# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Where this landing site lives, and the main website it links to
NEXT_PUBLIC_SITE_URL=https://go.abhivorn.com
NEXT_PUBLIC_MAIN_SITE_URL=https://www.abhivorn.com

# EmailJS — lead form delivery (same service as the main website; the form shows an error until these are set)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Google tags (defaults shown). GA4 is loaded by the page itself, so don't add a GA4 tag inside GTM (double counting).
NEXT_PUBLIC_GTM_ID=GTM-PSX78PTV
NEXT_PUBLIC_GA_ID=G-T85PQHQ4C6
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18110944464
# Label of your Google Ads "Lead" conversion action. With it set, every sent form counts as an Ads conversion.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Microsoft Clarity project ID (optional)
NEXT_PUBLIC_CLARITY_ID=
